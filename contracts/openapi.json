{
  "components": {
    "schemas": {
      "BiddingTrack": {
        "description": "FR-16.1 \u2014 what the eligibility engine turns on.\n\n`UNKNOWN` is a first-class answer, not a failure: NFR-LEGAL-1 requires we say\nso plainly rather than guess (eval C5 forbids confident-wrong here).",
        "enum": [
          "ncb",
          "icb",
          "donor",
          "private",
          "unknown"
        ],
        "title": "BiddingTrack",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MatchOut": {
        "description": "Public shape for GET /api/v1/matches (org-scoped, FR-7.1).",
        "properties": {
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "state": {
            "$ref": "#/components/schemas/MatchState"
          },
          "tender": {
            "$ref": "#/components/schemas/TenderOut"
          },
          "tender_id": {
            "format": "uuid",
            "title": "Tender Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tender_id",
          "score",
          "explanation",
          "state",
          "tender"
        ],
        "title": "MatchOut",
        "type": "object"
      },
      "MatchState": {
        "enum": [
          "new",
          "saved",
          "dismissed"
        ],
        "title": "MatchState",
        "type": "string"
      },
      "MeOut": {
        "properties": {
          "org": {
            "$ref": "#/components/schemas/OrgOut"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "org"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "OrgOut": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "org_type": {
            "$ref": "#/components/schemas/OrgType"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "org_type",
          "country",
          "timezone"
        ],
        "title": "OrgOut",
        "type": "object"
      },
      "OrgType": {
        "description": "FR-1.6 \u2014 the most load-bearing enum in the product.\n\nDrives eligibility logic (M16), currency display, and channel defaults. A\ntender an org's type cannot bid on is down-ranked and labeled, never silently\nhidden (FR-7.6).",
        "enum": [
          "local",
          "diaspora",
          "foreign"
        ],
        "title": "OrgType",
        "type": "string"
      },
      "RegisterIn": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "org_name": {
            "title": "Org Name",
            "type": "string"
          },
          "org_type": {
            "$ref": "#/components/schemas/OrgType"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "timezone": {
            "default": "Africa/Addis_Ababa",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "org_name",
          "org_type",
          "country"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "RegisterOut": {
        "description": "AUTH-1 response. Carries `org` and `audience_note` (ADR-029) so a\n`local`-type org learns immediately what it can and can't do here rather\nthan discovering an empty feed later \u2014 a silent gap is indistinguishable\nfrom a bug (see `identity.service.require_bidder_audience`).",
        "properties": {
          "audience_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience Note"
          },
          "org": {
            "$ref": "#/components/schemas/OrgOut"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "org"
        ],
        "title": "RegisterOut",
        "type": "object"
      },
      "RunLedgerOut": {
        "description": "Single run ledger entry schema.",
        "properties": {
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "error_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Kind"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items_created": {
            "title": "Items Created",
            "type": "integer"
          },
          "items_seen": {
            "title": "Items Seen",
            "type": "integer"
          },
          "items_unchanged": {
            "title": "Items Unchanged",
            "type": "integer"
          },
          "items_updated": {
            "title": "Items Updated",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "tokens_in": {
            "title": "Tokens In",
            "type": "integer"
          },
          "tokens_out": {
            "title": "Tokens Out",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "ref",
          "status",
          "started_at",
          "finished_at",
          "duration_ms",
          "items_seen",
          "items_created",
          "items_updated",
          "items_unchanged",
          "tokens_in",
          "tokens_out",
          "cost_usd",
          "error_kind",
          "error_detail"
        ],
        "title": "RunLedgerOut",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "running",
          "success",
          "failed"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "SpendSummaryOut": {
        "description": "AI token spend & cost summary (FR-11.5, NFR-COST-1).",
        "properties": {
          "failed_runs": {
            "title": "Failed Runs",
            "type": "integer"
          },
          "successful_runs": {
            "title": "Successful Runs",
            "type": "integer"
          },
          "total_cost_usd": {
            "title": "Total Cost Usd",
            "type": "number"
          },
          "total_runs": {
            "title": "Total Runs",
            "type": "integer"
          },
          "total_tokens_in": {
            "title": "Total Tokens In",
            "type": "integer"
          },
          "total_tokens_out": {
            "title": "Total Tokens Out",
            "type": "integer"
          }
        },
        "required": [
          "total_runs",
          "successful_runs",
          "failed_runs",
          "total_tokens_in",
          "total_tokens_out",
          "total_cost_usd"
        ],
        "title": "SpendSummaryOut",
        "type": "object"
      },
      "TenderListOut": {
        "description": "Keyset-paginated page (05 \u00a712 \u2014 stable and O(1) at any depth, unlike OFFSET).\n\n`next_after` is an opaque cursor: pass it back as ?after= to get the next page;\nnull means last page.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TenderOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next After"
          }
        },
        "required": [
          "items",
          "next_after"
        ],
        "title": "TenderListOut",
        "type": "object"
      },
