# Copy to .env and fill. Never commit .env (see .gitignore).
# Every value here is read through app/core/config.py — never os.getenv elsewhere (05 §2).

ENV=local
DEBUG=true

# --- Database / queue -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://adera:adera@localhost:5435/adera
REDIS_URL=redis://localhost:6380/0

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

# Session cookies: a `Secure` cookie is never sent back by a browser over plain
# HTTP (curl ignores the flag, which is how this hid for so long). Defaults to
# false for ENV=local so web/mobile can integrate without TLS, true everywhere
# else. Set explicitly to override.
# COOKIE_SECURE=false

# CORS: cookie auth means credentialed requests, which forbids the "*" wildcard,
# so browser origins must be listed. Comma-separated. PROD MUST SET THIS.
CORS_ORIGINS=http://localhost:3000

# HTTP rate limiting (docs/11 §0 -> 429 `rate_limited` + Retry-After).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=300
# Only enable behind a reverse proxy that sets X-Forwarded-For (infra/Caddyfile).
# Trusting it without a proxy lets any client forge its own IP per request.
TRUST_PROXY_HEADERS=false

# --- AI Kernel (Week 2-3; all model I/O routes through app/kernel — ADR-014) --
# LiteLLM reads provider keys from the environment. MODEL_ROUTES (app/kernel/router.py)
# currently routes via OpenRouter ("openrouter/..." model strings) — set this one:
# OPENROUTER_API_KEY=
# Direct-provider alternatives, if MODEL_ROUTES is changed to use them instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
KERNEL_DAILY_BUDGET_USD=5.0        # NFR-COST-1: hard cap + breaker
KERNEL_CACHE_TTL_SECONDS=604800

# --- Storage: Cloudflare R2, S3-compatible (Week 2; ADR-013) ----------------
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=adera-raw

# --- Ingestion --------------------------------------------------------------
# FR-2.5: identified UA + per-source rate limits. Be a good citizen; we scrape
# facts, link out, and honour robots.txt.
FETCH_USER_AGENT=ADERA/0.1 (+https://adera.bid/about/crawler; tenders@adera.bid)
FETCH_TIMEOUT_SECONDS=30
