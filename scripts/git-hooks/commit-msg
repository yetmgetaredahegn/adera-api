#!/usr/bin/env bash
# Rejects commits that attribute an AI agent as a co-author (AGENTS.md rule 16).
# Blocks known AI-tool signatures specifically -- human co-authors (real
# teammates pairing) are never restricted by this hook.
#
# Installed by `make install-hooks` (copies this into .git/hooks/commit-msg).

set -euo pipefail

MSG_FILE="$1"

# Case-insensitive match on Co-Authored-By lines naming a known AI tool/vendor.
# Match the vendor name, not a domain: the trailer that reaches this hook in
# practice is "Cursor <cursoragent@cursor.com>", which a `cursor\.sh` pattern
# silently let through for two commits before anyone noticed.
PATTERN='^Co-Authored-By:.*(claude|anthropic|gpt|openai|copilot|codeium|cursor|gemini|bard)'

if grep -qiE "$PATTERN" "$MSG_FILE"; then
  echo ""
  echo "COMMIT REJECTED: an AI agent is listed as a Co-Authored-By trailer."
  echo ""
  echo "  $(grep -iE "$PATTERN" "$MSG_FILE")"
  echo ""
  echo "Standing policy (AGENTS.md rule 16): no AI agent is ever a commit"
  echo "co-author, in any ADERA repo. Describe the agent's contribution in the"
  echo "commit body instead, and commit as yourself."
  echo ""
  echo "If you did not type that line: the editor appends it to every commit."
  echo "Turn that setting off rather than deleting the line each time -- it is"
  echo "re-added on amend, so a retry alone will not clear it."
  echo ""
  exit 1
fi
